--- util-linux-2.42.1/include/pidfd-utils.h	2026-05-18 13:20:50.000000000 +0300
+++ util-linux-2.42.1/include/pidfd-utils.h.patch	2026-10-09 16:15:00.000000000 +0000
@@ -38,27 +38,30 @@
 # include <unistd.h>
 
 # if !defined(HAVE_PIDFD_SEND_SIGNAL) && defined(SYS_pidfd_send_signal)
